# AWS Credentials (from sandbox console)
# Sandbox URL: https://079059455177.signin.aws.amazon.com/console?region=us-east-1
export AWS_ACCESS_KEY_ID=your_aws_access_key_here
export AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
export AWS_DEFAULT_REGION=us-east-1

# GitHub Tokens (IMPORTANT: Keep these separate!)
#
# GITHUB_TOKEN - For Airflow to comment on PRs
# Create at: https://github.com/settings/tokens?type=beta
# Permissions: Pull requests (read/write), Contents (read-only)
export GITHUB_TOKEN=github_pat_your_airflow_token_here

# ANTHROPIC_GITHUB_TOKEN - For Claude Code with GitHub integration
# This is Claude's access token, separate from the project's GITHUB_TOKEN
export ANTHROPIC_GITHUB_TOKEN=github_pat_your_claude_token_here

# GitHub Repository Information
export GITHUB_REPO=vanikkars/data-contract-flow

# Terraform Variables - Registry Settings
export TF_VAR_registry_name=schema-registry
export TF_VAR_registry_description="Schema Registry for data contracts"